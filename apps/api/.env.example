# API Environment — copy to .env
PORT=3001
NODE_ENV=development
DB_PATH=./data/catalogpilot.db
LOG_LEVEL=debug

# Google Gemini (leave blank for demo mode)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# WooCommerce (leave blank for demo mode)
WC_SITE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_TIMEOUT_MS=10000
WC_MAX_RETRIES=3

# Feature flags
DEMO_MODE=true

# CORS — frontend origin
FRONTEND_URL=http://localhost:5173
